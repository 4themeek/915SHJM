# Copy this file to .env.local and fill in real values for local development.
# In production, these are set in Vercel → Project → Settings → Environment Variables.

# --- Stripe (checkout + donations) ---
STRIPE_SECRET_KEY=sk_live_or_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
# Signing secret from Stripe Dashboard → Developers → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.thesacredhearts.org

# --- Shippo (shipping rates + label purchase/void) ---
SHIPPO_API_KEY=shippo_live_or_test_...

# --- Admin panel ---
# Comma-separated list of email addresses allowed to log in at /admin
ADMIN_EMAIL=you@example.com
# Any long random string, used to sign admin session/magic-link JWTs
ADMIN_JWT_SECRET=change-me-to-a-long-random-string

# --- Brevo (sends the admin magic-link login emails) ---
BREVO_API_KEY=xkeysib-...

# --- Postgres (Neon, via the Vercel integration) ---
# NOTE: as of Aug 2026 these are marked "Sensitive" in Vercel, meaning once set
# they can never be read back via `vercel env pull` or the dashboard by anyone,
# including Claude running in a sandboxed tool. Get the real values directly
# from Vercel → Storage → your Postgres store if you ever need to reconnect.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# --- Vercel Blob (currently unused/broken — see PROJECT_STATUS.md) ---
# The connected Blob store is set to Private access, but the upload code
# requests public access, so image uploads via the admin panel currently fail.
# Not required unless that's fixed.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# --- Present in Vercel but not currently used in code ---
# RESEND_API_KEY was set up at some point but nothing in the app calls it today.
# The contact form (src/app/contact/ContactForm.tsx) does not actually send
# email yet — see PROJECT_STATUS.md.
# RESEND_API_KEY=
